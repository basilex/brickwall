#
# NATS settings
#
NATS_URL=nats://host.docker.internal:4222
NATS_PORT=4222
NATS_MAX_RECONNECT=60
NATS_RECONNECT_WAIT=2s
NATS_RECONNECT_JITTER=100ms
NATS_RECONNECT_JITTER_TLS=1s
NATS_TIMEOUT=2s
NATS_PING_INTERVAL=2m
NATS_MAX_PING_OUT=2
NATS_RECONNECT_BUF_SIZE=8388608 # 8Mb
NATS_DRAIN_TIMEOUT=30s
NATS_FLUSHER_TIMEOUT=1m
