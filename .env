#
# Common settings
#
APP_MODE=debug

GIN_MODE=debug
GIN_LOG_COLOR=false

PGX_LOG_LEVEL=debug
VOLUMES_BASE=volume
#
# Server settings
#
SERVER_ADDRESS=0.0.0.0:8081
SERVER_READ_TIMEOUT=3s
SERVER_WRITE_TIMEOUT=3s
SERVER_GRACEFUL_TIMEOUT=5s
SERVER_MAX_HEADER_BYTES=1048576
#
# Auth settings
#

#
# CORS settings
#
CORS_ENABLED=true
CORS_ALLOW_ORIGIN=*
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Accept,Authorization,Content-Type,X-CSRF-Token
CORS_ALLOW_CREDENTIALS=false
CORS_EXPOSE_HEADERS=*
CORS_MAX_AGE=600
#
# Jwt settings
#
# $ openssl rand -hex 32
JWT_SECRET=3680298303d4a804a9e5c8ba74ca79e97ef409b023bd361e8b5283199a1610f6
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=24h
#
# NATS settings
#
NATS_URL=nats://nats:4222,nats://nats:4223,nats://nats:4224
NATS_PORT=4222
NATS_MAX_RECONNECT=60
NATS_RECONNECT_WAIT=2s
NATS_RECONNECT_JITTER=100ms
NATS_RECONNECT_JITTER_TLS=1s
NATS_TIMEOUT=2s
NATS_PING_INTERVAL=2m
NATS_MAX_PING_OUT=2
NATS_RECONNECT_BUF_SIZE=8388608 # 8Mb
NATS_DRAIN_TIMEOUT=30s
NATS_FLUSHER_TIMEOUT=1m
#
# Postgres settings
#
POSTGRES_DB=bspdb_dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=system
POSTGRES_PASSWORD=passw0rd
POSTGRES_MAX_CONNS=100
POSTGRES_MIN_CONNS=5
POSTGRES_MAX_CONN_LIFE_TIME=10m
POSTGRES_MAX_CONN_IDLE_TIME=3m
POSTGRES_HEALTH_CHECK_PERIOD=30s
#
# Redis settings
#
REDIS_ADDR=redis:6379
REDIS_NETWORK=tcp
REDIS_CLIENT_NAME=bsp
REDIS_DB=0
#
# SMTP settings
#
SMTP_SERVER_HOST=maildev
SMTP_SERVER_PORT=1025
SMTP_SERVER_USER=system
SMTP_SERVER_PASSWORD=passw0rd
SMTP_SENDER_FROM=no-replay@brickwall.com
SMTP_TEMPLATES=template
SMTP_USE_TLS=false
#
# TLS/SSL settings
#
TLS_SSL_ENABLED=false
TLS_SSL_CERT=/app/resource/cert/server.crt
TLS_SSL_KEY=/app/resource/cert/server.key
#
# eof
#
